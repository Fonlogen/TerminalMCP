{
  "name": "terminalmcp",
  "version": "0.1.0",
  "description": "Zero-dependency MCP server that gives AI agents full control of a machine — shell, filesystem, git, package managers, processes, network — with token efficiency as a design constraint.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agent",
    "agent-tools",
    "shell",
    "terminal",
    "command-line",
    "devops",
    "automation",
    "claude",
    "claude-code",
    "anthropic",
    "llm-tools",
    "token-efficient",
    "zero-dependency",
    "cross-platform",
    "stdio",
    "streamable-http",
    "sse"
  ],
  "homepage": "https://github.com/Fonlogen/TerminalMCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fonlogen/TerminalMCP.git"
  },
  "bugs": {
    "url": "https://github.com/Fonlogen/TerminalMCP/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "terminalmcp": "bin/terminalmcp.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node bin/terminalmcp.js",
    "test": "node test/smoke.mjs && node test/guards.mjs && node test/tools.mjs && node test/vars.mjs && node test/http.mjs",
    "print-config": "node bin/terminalmcp.js --print-config",
    "test:smoke": "node test/smoke.mjs",
    "test:guards": "node test/guards.mjs",
    "doctor": "node bin/terminalmcp.js --doctor",
    "install-skill": "node scripts/install-skill.mjs",
    "test:http": "node test/http.mjs",
    "start:http": "node bin/terminalmcp.js --http",
    "test:tools": "node test/tools.mjs",
    "list-tools": "node bin/terminalmcp.js --list-tools",
    "test:vars": "node test/vars.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "scripts",
    "terminalmcp.config.example.json",
    "README.md",
    "LICENSE"
  ]
}
