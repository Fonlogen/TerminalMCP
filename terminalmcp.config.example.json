{
  // Copy to terminalmcp.config.json (next to the server, or in the working
  // directory), or to ~/.terminalmcp/config.json. Comments are allowed.
  // Every field is optional — the defaults below are what the server uses.

  // Shell to run commands in.
  //   "auto"  -> system default: pwsh > powershell > cmd on Windows,
  //              $SHELL then bash > zsh > sh elsewhere
  // Named:     "bash", "gitbash", "zsh", "fish", "sh",
  //            "cmd", "powershell", "pwsh", "wsl"
  // Or an absolute path: "C:/Program Files/Git/bin/bash.exe"
  "shell": "auto",

  // Extra shells you can then select by name, per call or as "shell" above.
  "shells": {
    // "busybox": { "command": "C:/tools/busybox.exe", "args": ["sh", "-c"] },
    // "docker":  { "command": "docker", "args": ["exec", "-i", "web", "sh", "-c"] }
  },

  // Run through a login shell (-lc) so ~/.profile aliases and PATH apply.
  "login": false,

  // Default working directory. null = the directory the server was started in.
  "cwd": null,

  // Per-command timeout in ms; the whole process tree is killed. 0 = no limit.
  "timeoutMs": 120000,

  // Byte cap per returned stream before middle-truncation (~4 bytes/token).
  "maxOutputBytes": 16000,

  // In-memory buffer cap per stream for background jobs.
  "maxBufferBytes": 8388608,

  // Environment variables injected into every command.
  "env": {},

  // Keep ANSI colour codes in output (costs tokens; off by default).
  "keepAnsi": false,

  // Background job limits.
  "maxJobs": 32,
  "jobRetentionMs": 1800000,

  // ---- Optional guardrails. Leave as-is for unrestricted access. ----

  // Restrict the file tools to these directories (also blocks symlink escapes).
  "allowedRoots": [],

  // Refuse commands matching any of these regexes (case-insensitive).
  "denyCommands": [
    // "rm\\s+-rf\\s+/",
    // "mkfs",
    // ":\\(\\)\\{.*\\};:"
  ],

  // Refuse writes to paths matching any of these regexes.
  "denyPaths": [
    // "\\.env$",
    // "id_rsa"
  ],

  // Block all writes and all command execution (inspection only).
  "readOnly": false,

  // Append a JSONL audit line per tool call.
  "logFile": null,

  // ---- Server-side variable store (the `vars` tool and ${vars.x}). ----

  // Mirror the store to this file so variables survive a restart.
  // null = memory only, forgotten when the server stops.
  "varsFile": null,
  // Write variables marked secret to that file too. Off by default: a file on
  // disk is a different exposure than a value in a running process.
  "persistSecrets": false,
  "maxVars": 200,
  "maxVarBytes": 1048576,
  "maxVarsTotalBytes": 8388608,

  // Which tool groups to expose. Tool schemas sit in the model's context on
  // EVERY request, so a narrower profile is cheaper per call.
  //   "all"     every group          25 tools, ~10.7k tokens
  //   "core"    shell/jobs/files      9 tools,  ~4.1k tokens
  //   "dev"     core + search, git, fs, dev, data   (~8.5k)
  //   "ops"     core + search, fs, archive, sys, net (~7.7k)
  // Or list groups: "core,git,search"   Or remove some: "all,-watch,-archive"
  // Groups: core, vars, search, git, fs, archive, sys, net, dev, data, watch,
  //         browser, screen
  // Bundles: all, minimal, dev, ops, web
  "tools": "all",

  // ---- Browser control (the `browser` tool). ----
  "browser": {
    // Path to a Chromium-family binary (Chrome, Chromium, Edge, Brave).
    // null = look in the usual install locations, then $CHROME_PATH, then a
    // Playwright/Puppeteer cache if one is already on disk. Nothing is
    // downloaded. Firefox is not supported: it dropped most of its CDP
    // surface in favour of WebDriver BiDi, a different protocol.
    "executable": null,
    // false opens a real window — what you want when a human is watching.
    "headless": true,
    // Debugging port for browsers we launch. 0 = let the browser choose,
    // which is race-free: it reports the port back through its profile dir.
    "port": 0,
    // Profile directory, so logins survive between runs.
    // null = a throwaway temp profile per launch, signed into nothing.
    "userDataDir": null,
    "args": [],
    "viewport": { "width": 1280, "height": 800 },
    // alert()/confirm() must be answered or the page freezes: "accept" or
    // "dismiss". Either way the message is reported back.
    "dialogs": "accept",
    // Where the browser puts downloads, so the file tools can find them.
    // null = <cwd>/.terminalmcp/downloads
    "downloadDir": null,
    "maxConsoleEvents": 300,
    "maxNetworkEvents": 300,
    "commandTimeoutMs": 30000,
    "launchTimeoutMs": 30000
  },

  // ---- Screenshots, from the browser or the desktop. ----
  "screenshots": {
    // Where captures are saved. null = <cwd>/.terminalmcp/shots
    "dir": null,
    // An image costs roughly width x height / 750 tokens, so this is the real
    // control: 1200px wide is about a tenth of the cost of 4K, and readable.
    "maxWidth": 1200,
    "maxHeight": 1600,
    "maxImageBytes": 5242880
  },

  // ---- Remote HTTP transport (default: off, stdio is used instead). ----
  // There is NO authentication. Binding anything other than 127.0.0.1 gives
  // a full shell on this machine to anyone who can reach the port.
  "http": {
    "enabled": false,
    // 127.0.0.1 = local only. Use "0.0.0.0" to accept remote connections.
    "host": "127.0.0.1",
    "port": 8787,
    // Streamable HTTP endpoint (MCP 2025-03-26 / 2025-06-18).
    "path": "/mcp",
    // Legacy HTTP+SSE endpoints (MCP 2024-11-05), served at the same time.
    "ssePath": "/sse",
    "messagePath": "/messages",
    "maxBodyBytes": 33554432,
    "cors": true,
    // Reject requests carrying an unknown Mcp-Session-Id instead of serving them.
    "strictSessions": false,
    // Answer POSTs with an SSE stream even when the client would take JSON.
    // Only needed behind a proxy that cuts idle responses during long commands.
    "sseReplies": false
  }
}
